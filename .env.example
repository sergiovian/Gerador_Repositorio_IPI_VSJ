# Porta onde o servidor será executado
PORT=3000

# Ambiente de execução: development, test ou production
NODE_ENV=development

# Caminho do banco SQLite
DATABASE_PATH=./backend/database/louvor-inteligente.db

# Obrigatório em produção. Gere um valor longo e aleatório (mínimo recomendado: 32 bytes).
SESSION_SECRET=

# Use somente na primeira inicialização ou para rotacionar a senha do administrador.
# Mínimo de 12 caracteres. Remova do .env após a rotação bem-sucedida.
BOOTSTRAP_ADMIN_PASSWORD=
